server {
    listen 192.0.2.40:443 ssl;
    server_name forge.internal.example;
    ssl_certificate /etc/prometheus-forge/tls/backend.crt;
    ssl_certificate_key /etc/prometheus-forge/tls/backend.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location ^~ /prometheus/ {
        allow 192.0.2.1;
        deny all;
        auth_basic "Prometheus Forge";
        auth_basic_user_file /etc/prometheus-forge/operators.htpasswd;

        client_max_body_size 1k;
        proxy_pass http://unix:/run/prometheus-forge/forge.sock:;
        proxy_set_header X-Forge-Operator $remote_user;
        proxy_set_header Authorization "";
        proxy_read_timeout 195s;
    }

    location / { return 404; }
}
